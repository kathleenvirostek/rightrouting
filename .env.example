# RightRoute environment variables.
# Set these in Netlify: Project configuration → Environment variables.
# Never commit real values. Locally, `netlify dev` pulls them from your Netlify project.

# --- AI (Claude) -------------------------------------------------------------
# NOT REQUIRED on Netlify. Netlify AI Gateway injects Anthropic credentials
# automatically into Functions (usage is billed to your Netlify credits).
# Only set this if you want to use your own Anthropic account instead:
# create a key at https://console.anthropic.com → Settings → API keys.
# ANTHROPIC_API_KEY=

# --- Email notifications (optional) -------------------------------------------
# Without these, notifications are in-app only (bell icon) and runs log "email: skipped".
# 1. Sign up free at https://resend.com (100 emails/day on the free tier).
# 2. Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=
# The inbox that receives ALL demo notifications (staff are fictional, so they
# share one inbox). On Resend's free tier without a verified domain, this must
# be the email address you signed up to Resend with.
NOTIFY_EMAIL_TO=
# Sender. Leave unset to use Resend's shared test sender (onboarding@resend.dev),
# or use an address on a domain you verified in Resend.
RESEND_FROM=

# --- Database ------------------------------------------------------------------
# Nothing to set. Netlify Database (managed Postgres) is provisioned automatically
# and its connection is injected at runtime. Migrations in
# netlify/database/migrations are applied on every deploy.
